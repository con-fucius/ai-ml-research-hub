---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const providers = await import.meta.glob('../../../_data/providers.yml');
  const providerData = await Object.values(providers)[0]();
  
  // The YAML import returns an array of providers
  return providerData.default.map(provider => ({
    params: { id: provider.id },
    props: { provider },
  }));
}

const { provider } = Astro.props;

const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
const homeUrl = baseUrl || '/';

const normalizedTimeline = (provider.timeline || [])
  .slice()
  .sort((a, b) => (b.date || '').localeCompare(a.date || ''));

const groups = new Map();
for (const evt of normalizedTimeline) {
  const key = evt.date || 'Unknown';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key).push(evt);
}

const orderedDates = Array.from(groups.keys());

const getModality = (evt) => {
  const hay = `${evt.model || ''} ${evt.type || ''} ${evt.specs || ''}`.toLowerCase();
  if (/(voice|audio|speech|realtime|webrtc)/.test(hay)) return 'voice';
  if (/(video|sora|vision\s*video)/.test(hay)) return 'video';
  return 'text';
};

const timelineRows = [];
let globalIndex = 0;
for (const date of orderedDates) {
  timelineRows.push({ kind: 'date', date });
  for (const evt of groups.get(date)) {
    const side = globalIndex % 2 === 0 ? 'left' : 'right';
    timelineRows.push({ kind: 'event', date, evt, side, modality: getModality(evt) });
    globalIndex++;
  }
}
---
<Layout title={`${provider.name} - Model Evolution`}>
  <div class="model-page-container">
    <nav class="breadcrumb">
      <a href={homeUrl}>Home</a>
      <span class="sep">/</span>
      <span class="curr">{provider.name}</span>
    </nav>

    <header class="provider-header">
      <h1 class="provider-title">{provider.name}</h1>
      <p class="provider-desc">{provider.description}</p>
    </header>

    <div class="timeline-container">
      {timelineRows.length > 0 ? (
        timelineRows.map((row) => (
          row.kind === 'date' ? (
            <div class="timeline-date-marker">
              <span class="date-text">{row.date}</span>
            </div>
          ) : (
            <div class={`timeline-item ${row.side} modality-${row.modality}`}>
              <div class="timeline-card">
                <div class="content-header">
                  <h3>{row.evt.model}</h3>
                  <span class="badge-type">{row.evt.type}</span>
                </div>
                <div class="specs-row">
                  <span class="spec-label">Specs:</span>
                  <span class="spec-value">{row.evt.specs}</span>
                </div>
                <p class="event-desc">{row.evt.description}</p>
              </div>
            </div>
          )
        ))
      ) : (
        <p class="muted-text">No timeline data available for this provider.</p>
      )}
    </div>
  </div>
</Layout>

<style>
  .model-page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  .breadcrumb { display: flex; gap: 0.5rem; font-size: 0.85rem; color: var(--muted-color); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2rem; }
  .breadcrumb a { color: var(--accent-color); text-decoration: none; }
  .breadcrumb .sep { opacity: 0.3; }
  .curr { color: var(--text-color); font-weight: 600; }

  .provider-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }
  
  .provider-title {
    margin: 0 0 0.25rem 0;
    letter-spacing: -0.02em;
  }
  
  .provider-desc {
    font-size: 1rem;
    color: var(--muted-color);
    margin: 0;
    max-width: 600px;
  }

  /* Timeline */
  .timeline-container {
    position: relative;
    padding: 0.1rem 0;
    max-width: 1000px;
    margin: 0 auto;
  }

  .timeline-container::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-0.5px);
    background: var(--border-color);
    opacity: 0.5;
  }

  .timeline-date-marker {
    position: relative;
    display: flex;
    justify-content: center;
    margin: 0.25rem 0;
    z-index: 10;
  }

  .timeline-date-marker .date-text {
    font-family: var(--font-code);
    font-size: 0.7rem;
    color: var(--muted-color);
    background: var(--bg-color);
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 30px 1fr;
    align-items: center;
    margin: 0.1rem 0;
  }

  .timeline-item::after {
    content: '';
    grid-column: 2;
    justify-self: center;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bg-color);
    border: 1.5px solid var(--accent-color);
    z-index: 2;
    box-shadow: 0 0 0 4px var(--bg-color);
  }

  .timeline-item.left .timeline-card { grid-column: 1; text-align: right; border-right-width: 3px; border-left-width: 1px; }
  .timeline-item.right .timeline-card { grid-column: 3; text-align: left; border-left-width: 3px; border-right-width: 1px; }

  .timeline-card {
    background: var(--surface-color);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border-color);
    padding: 0.5rem 0.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .timeline-card:hover {
    border-color: var(--accent-color);
    background: var(--surface-flat);
    transform: scale(1.01);
    z-index: 5;
    box-shadow: var(--shadow-md);
  }

  /* Modality Colors - Creative & Subtle */
  .modality-text .timeline-card { 
    border-color: rgba(76, 154, 255, 0.2);
  }
  .modality-text:hover .timeline-card { 
    background: linear-gradient(to bottom right, var(--surface-flat), rgba(76, 154, 255, 0.05));
    border-color: var(--accent-color);
  }

  .modality-voice .timeline-card { 
    border-color: rgba(121, 242, 192, 0.2);
  }
  .modality-voice:hover .timeline-card { 
    background: linear-gradient(to bottom right, var(--surface-flat), rgba(121, 242, 192, 0.05));
    border-color: #10b981;
  }

  .modality-video .timeline-card { 
    border-color: rgba(255, 184, 77, 0.2);
  }
  .modality-video:hover .timeline-card { 
    background: linear-gradient(to bottom right, var(--surface-flat), rgba(255, 184, 77, 0.05));
    border-color: #f59e0b;
  }

  .content-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
    gap: 0.5rem;
  }

  .timeline-item.left .content-header { flex-direction: row-reverse; }

  .content-header h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--heading-color);
  }

  .badge-type {
    font-size: 0.65rem;
    padding: 0.1rem 0.4rem;
    background: var(--accent-subtle);
    border: 1px solid var(--accent-color);
    border-radius: 4px;
    color: var(--accent-color);
    white-space: nowrap;
    opacity: 0.8;
  }

  .specs-row {
    font-size: 0.75rem;
    margin-bottom: 0.25rem;
    font-family: var(--font-code);
    opacity: 0.8;
  }

  .timeline-item.left .specs-row { text-align: right; }

  .spec-label {
    color: var(--muted-color);
    margin-right: 0.25rem;
  }

  .spec-value {
    color: var(--heading-color);
  }

  .event-desc {
    margin: 0;
    color: var(--text-color);
    font-size: 0.8rem;
    line-height: 1.4;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .timeline-container::before { left: 10px; transform: none; }
    .timeline-item { grid-template-columns: 20px 1fr; gap: 0.5rem; }
    .timeline-item::after { grid-column: 1; justify-self: center; }
    .timeline-item.left .timeline-card,
    .timeline-item.right .timeline-card { 
      grid-column: 2; 
      text-align: left; 
      border-left-width: 3px; 
      border-right-width: 1px; 
    }
    .timeline-item.left .content-header { flex-direction: row; }
    .timeline-item.left .specs-row { text-align: left; }
    .timeline-date-marker { justify-content: flex-start; padding-left: 30px; }
  }

  body.light-theme .modality-text { border-color: rgba(37, 99, 235, 0.15); }
  body.light-theme .modality-voice { border-color: rgba(124, 58, 237, 0.2); }
  body.light-theme .modality-video { border-color: rgba(220, 38, 38, 0.2); }
</style>
