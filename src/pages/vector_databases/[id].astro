---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  // With the YAML plugin, Astro can import the data directly.
  const ymlFiles = await import.meta.glob('../../../_data/vector_databases/*.yml');

  const vectordbs = (await Promise.all(
    Object.values(ymlFiles).map(async resolver => {
      const { default: vectordb } = await resolver();
      return vectordb;
    })
  )).filter(v => !v?.hidden);

  return vectordbs.map(vectordb => {
    const related = vectordbs
      .filter(v => v.id !== vectordb.id)
      .sort(() => 0.5 - Math.random())
      .slice(0, 3);

    return {
      params: { id: vectordb.id },
      props: { vectordb, related },
    };
  });
}

const { vectordb, related } = Astro.props;

const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
const homeUrl = baseUrl || '/';

const resourceLinks = [
  { label: 'Website', url: vectordb.websiteUrl },
  { label: 'GitHub', url: vectordb.githubUrl },
  { label: 'Documentation', url: vectordb.docsUrl },
  { label: 'Cloud', url: vectordb.cloudUrl },
  { label: 'Cookbook', url: vectordb.cookbookUrl },
  { label: 'Issue Tracker', url: vectordb.issueUrl },
  { label: 'Harmony RFC', url: vectordb.harmonyRfcUrl },
  { label: 'HoneyBee Paper', url: vectordb.honeybeePaperUrl },
  { label: 'Changelog', url: vectordb.changelogUrl },
  { label: 'GA', url: vectordb.gaAnnouncementUrl },
  { label: 'Bedrock', url: vectordb.bedrockIntegrationUrl },
  { label: 'ENN Blog', url: vectordb.ennBlogUrl },
  { label: 'Quantization', url: vectordb.quantizationBlogUrl },
  { label: 'Spring Data', url: vectordb.springDataBlogUrl },
  { label: 'Release Notes', url: vectordb.releaseNotesUrl },
  { label: 'Python', url: vectordb.pythonClientUrl },
  { label: 'TypeScript', url: vectordb.tsClientUrl },
  { label: 'Vercel', url: vectordb.vercelStarterUrl },
  { label: 'Vertex RAG', url: vectordb.vertexRagUrl },
  { label: 'n8n', url: vectordb.n8nDocsUrl },
  { label: 'OpenAPI', url: vectordb.openApiUrl },
  { label: 'Helm', url: vectordb.helmChartUrl },
  { label: 'Console', url: vectordb.cloudConsoleUrl },
  { label: 'Web UI', url: vectordb.webUiUrl },
  { label: 'Benchmark', url: vectordb.benchmarkUrl },
  { label: 'Cloud Blog', url: vectordb.cloudBlogUrl },
  { label: 'Roadmap', url: vectordb.roadmapUrl },
  { label: 'TS Client', url: vectordb.typescriptClientUrl },
  { label: 'Java', url: vectordb.javaClientUrl },
  { label: 'Recipes', url: vectordb.recipesUrl },
  { label: 'Blog', url: vectordb.blogUrl },
  { label: 'v1.29', url: vectordb.v129ReleaseUrl },
  { label: 'v1.30', url: vectordb.v130ReleaseUrl },
  { label: 'v1.31', url: vectordb.v131ReleaseUrl },
  { label: 'NVIDIA', url: vectordb.nvidiaPartnershipUrl },
].filter((r) => Boolean(r.url));

const headerLinks = new Set([vectordb.websiteUrl, vectordb.githubUrl, vectordb.docsUrl, vectordb.cloudUrl].filter(Boolean));
const extraResources = [];
const seenUrls = new Set(headerLinks);
for (const r of resourceLinks) {
  if (r.url && !seenUrls.has(r.url)) {
    extraResources.push(r);
    seenUrls.add(r.url);
  }
}
const matrixColumns = (() => {
  if (Array.isArray(vectordb?.matrixColumns) && vectordb.matrixColumns.length > 0) return vectordb.matrixColumns;
  const firstRow = (vectordb?.comparisonMatrix && vectordb.comparisonMatrix[0]) || {};
  const keys = Object.keys(firstRow).filter((k) => k !== 'capability');
  return keys.map((key) => ({ key, label: key }));
})();
---
<Layout title={vectordb.name}>
  <nav class="breadcrumb">
    <a href={homeUrl}>Home</a>
    <span class="breadcrumb-separator">›</span>
    <a href={`${homeUrl}#vector_databases`}>Vector Databases</a>
    <span class="breadcrumb-separator">›</span>
    <span class="breadcrumb-current">{vectordb.name}</span>
  </nav>
  
  <div class="vectordb-header">
    <h1>{vectordb.name}</h1>
    <div class="links">
      {vectordb.websiteUrl && <a href={vectordb.websiteUrl}>Website</a>}
      {vectordb.githubUrl && <><span class="separator">|</span><a href={vectordb.githubUrl}>GitHub</a></>}
      {vectordb.docsUrl && <><span class="separator">|</span><a href={vectordb.docsUrl}>Documentation</a></>}
      {vectordb.cloudUrl && <><span class="separator">|</span><a href={vectordb.cloudUrl}>Cloud</a></>}
    </div>
    <p class="summary">{vectordb.summary}</p>
  </div>

  <div class="vectordb-grid">
    <main class="main-content">
      {vectordb.isCollection ? (
        <div class="collection-view">
          <section id="comparison">
            <h2>Developer Capability Comparison Matrix</h2>
            <div class="table-container">
              <table class="comparison-matrix">
                <thead>
                  <tr>
                    <th>Capability</th>
                    {matrixColumns.map(col => (
                      <th>{col.label}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {vectordb.comparisonMatrix.map(row => (
                    <tr>
                      <td><strong>{row.capability}</strong></td>
                      {matrixColumns.map(col => (
                        <td>{row[col.key] ?? '—'}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          {vectordb.items.map(item => (
            <section id={item.id} class="collection-item">
              <div class="item-header">
                <h3>{item.name}</h3>
                <p class="item-summary">{item.summary}</p>
              </div>
              <div class="item-details">
                <div class="item-features">
                  <h4>Key AI Features</h4>
                  <ul>
                    {item.features.map(f => (
                      <li><strong>{f.title}:</strong> {f.description}</li>
                    ))}
                  </ul>
                </div>
                <div class="item-impact">
                  <h4>Developer Impact</h4>
                  <ul>
                    {item.impact.map(i => (
                      <li>{i}</li>
                    ))}
                  </ul>
                </div>
                {item.cloud && <div class="item-cloud"><strong>Managed Cloud:</strong> {item.cloud}</div>}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <>
          {extraResources.length > 0 && (
            <section>
              <h2>Official Resources</h2>
              <div class="resources-list-row">
                {extraResources.map((r, idx) => (
                  <>
                    {idx > 0 && <span class="separator">|</span>}
                    <a href={r.url} class="resource-link-inline">{r.label}</a>
                  </>
                ))}
              </div>
            </section>
          )}

          <section>
            <h2>Key Features</h2>
            <ul class="features-list">
              {vectordb.features && vectordb.features.map(feature => (
                <li><strong>{feature.title}:</strong> {feature.description}</li>
              ))}
            </ul>
          </section>

          <section>
            <h2>Code Examples</h2>
            {vectordb.codeSnippets && vectordb.codeSnippets.map(snippet => (
              <div class="code-example">
                <h3>{snippet.title}</h3>
                <div class="code-container">
                  <div class="code-header">
                    <span class="language-label">{snippet.language}</span>
                    <button class="copy-btn" onclick={`copyCode(this)`}>Copy</button>
                  </div>
                  <pre class="code-block"><code class={`language-${snippet.language}`}>{snippet.code}</code></pre>
                </div>
              </div>
            ))}
          </section>

          {vectordb.useCases && (
            <section>
              <h2>Use Cases</h2>
              <ul class="use-cases-list">
                {vectordb.useCases.map(useCase => <li>{useCase}</li>)}
              </ul>
            </section>
          )}

          {(vectordb.advantages || vectordb.disadvantages) && (
            <section>
              <h2>Pros & Cons</h2>
              <div class="pros-cons-grid">
                {vectordb.advantages && (
                  <div class="pros">
                    <details open>
                      <summary><h3>Advantages</h3></summary>
                      <ul>
                        {vectordb.advantages.map(advantage => <li>{advantage}</li>)}
                      </ul>
                    </details>
                  </div>
                )}
                {vectordb.disadvantages && (
                  <div class="cons">
                    <details open>
                      <summary><h3>Disadvantages</h3></summary>
                      <ul>
                        {vectordb.disadvantages.map(disadvantage => <li>{disadvantage}</li>)}
                      </ul>
                    </details>
                  </div>
                )}
              </div>
            </section>
          )}

          {vectordb.roadmap && vectordb.roadmap.length > 0 && (
            <section>
              <h2>Future Outlook & Integrations</h2>
              <ul class="roadmap-list">
                {vectordb.roadmap.map(item => (
                  <li><strong>{item.title}</strong> [{item.status}]: {item.description}</li>
                ))}
              </ul>
            </section>
          )}
        </>
      )}
    </main>
    <aside class="sidebar">
      {vectordb.isCollection ? (
        <section class="collection-nav">
          <h2>Database Index</h2>
          <ul class="nav-links">
            <li><a href="#comparison">Comparison Matrix</a></li>
            {vectordb.items.map(item => (
              <li><a href={`#${item.id}`}>{item.name}</a></li>
            ))}
          </ul>
        </section>
      ) : (
        vectordb.timeline && vectordb.timeline.length > 0 && (
          <section>
            <h2>Timeline</h2>
            <div class="timeline">
              {vectordb.timeline.map(event => (
                <div class="timeline-item" data-type={event.type}>
                  <div class="timeline-date">{event.date}</div>
                  <div class="timeline-content">
                    <div class="timeline-title">{event.description}</div>
                    {event.url && <a href={event.url} class="timeline-link">Source</a>}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )
      )}

      {related && related.length > 0 && (
        <div class="related-section" style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
          <h2>Related Vector DBs</h2>
          <ul class="related-list" style="list-style: none; padding: 0;">
            {related.map(item => (
              <li style="margin-bottom: 0.5rem;">
                <a href={`${baseUrl}/vector_databases/${item.id}`} style="text-decoration: none; color: var(--accent-color); font-weight: 500;">
                  {item.name}
                </a>
                <div style="font-size: 0.8rem; color: var(--muted-color);">{item.summary.substring(0, 60)}...</div>
              </li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</Layout>

<style>
  .breadcrumb {
    margin-bottom: 1.5rem;
    padding: 0.75rem 0;
    font-size: 0.9rem;
    color: var(--muted-color);
  }
  
  .breadcrumb a {
    color: var(--accent-color);
    text-decoration: none;
  }
  
  .breadcrumb a:hover {
    color: var(--heading-color);
    text-decoration: underline;
  }
  
  .breadcrumb-separator {
    margin: 0 0.5rem;
    color: var(--muted-color);
  }
  
  .breadcrumb-current {
    color: var(--heading-color);
    font-weight: 500;
  }

  .vectordb-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1.5rem;
  }
  .vectordb-header h1 {
    margin-bottom: 0.5rem;
    font-size: 2rem;
  }
  .links {
    margin-bottom: 1rem;
    font-family: var(--font-main);
    font-size: 0.85rem;
  }
  .summary {
    max-width: 100%;
    margin: 0;
    font-style: normal;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-color);
  }
  
  .vectordb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .vectordb-grid {
      grid-template-columns: 2fr 1fr;
    }
  }
  
  .main-content section {
    margin-bottom: 1.5rem;
  }
  .main-content h2 {
    margin-bottom: 0.75rem;
  }
  .main-content h3 {
    margin-bottom: 0.4rem;
  }
  
  .resources-list-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .resource-link-inline {
    color: var(--accent-color);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .resource-link-inline:hover {
    text-decoration: underline;
  }
  
  .features-list, .use-cases-list {
    padding-left: 1.5rem;
  }
  .features-list li, .use-cases-list li {
    margin-bottom: 0.2rem;
    line-height: 1.2;
  }
  
  .roadmap-list {
    padding-left: 1.5rem;
  }
  .roadmap-list li {
    margin-bottom: 0.5rem;
  }
  
  .code-example {
    margin-bottom: 1.5rem;
  }
  .code-example h3 {
    margin-bottom: 0.5rem;
    font-weight: normal;
    font-size: 1.1rem;
  }
  
  .code-container {
    position: relative;
    overflow: hidden;
  }
  
  .code-header {
    background-color: var(--code-bg);
    padding: 0.25rem 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #333;
  }
  
  .language-label {
    font-size: 0.7rem;
    color: #888;
    text-transform: lowercase;
    font-weight: 500;
    font-family: var(--font-code);
  }
  
  .copy-btn {
    background: none;
    border: 1px solid #555;
    color: #ccc;
    padding: 0.25rem 0.5rem;
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-code);
    text-transform: none;
  }
  
  .copy-btn:hover {
    background-color: #444;
    border-color: #777;
  }
  
  .code-block {
    background-color: var(--code-bg);
    border: none;
    border-radius: 0;
    padding: 1rem;
    margin: 0;
    font-size: 1.1em;
    overflow-x: auto;
    font-family: var(--font-code);
    line-height: 1.5;
  }
  .code-block code {
    background: none;
    border: none;
    padding: 0;
    color: #d4d4d4;
    font-size: inherit;
  }
  
  .sidebar {
    background: var(--card-bg);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    position: sticky;
    top: 6rem;
    height: fit-content;
  }

  .sidebar h2 {
    margin-bottom: 1rem;
    font-size: 1.1em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
  }
  
  .timeline {
    position: relative;
    padding-left: 2rem;
  }
  
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.75rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border-color);
  }
  
  .timeline-item {
    position: relative;
    display: flex;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-left: 1rem;
  }
  
  .timeline-item::before {
    content: '';
    position: absolute;
    left: -1.75rem;
    top: 0.25rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--primary-color);
    border: 2px solid var(--bg-color);
    z-index: 1;
  }
  
  /* Different colors for different event types */
  .timeline-item[data-type="Release"]::before {
    background: #4CAF50;
  }
  
  .timeline-item[data-type="Update"]::before {
    background: #2196F3;
  }
  
  .timeline-item[data-type="Launch"]::before {
    background: #FF9800;
  }
  
  .timeline-date {
    font-weight: bold;
    font-size: 0.9rem;
    min-width: 80px;
    flex-shrink: 0;
  }
  .timeline-content {
    flex: 1;
  }
  .timeline-title {
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
  }
  .timeline-link {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  /* Collection View Styles */
  .collection-view {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .table-container {
    overflow-x: auto;
    margin: 1rem 0;
    background: var(--surface-color);
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .comparison-matrix {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    text-align: left;
  }

  .comparison-matrix th, .comparison-matrix td {
    padding: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .comparison-matrix th {
    background: var(--surface-flat);
    color: var(--heading-color);
    font-weight: 600;
  }

  .collection-item {
    scroll-margin-top: 100px;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .item-header h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
    color: var(--accent-color);
  }

  .item-summary {
    font-size: 1rem;
    color: var(--text-color);
    margin-bottom: 1.25rem;
    opacity: 0.9;
  }

  .item-details {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .item-details {
      grid-template-columns: 1fr 1fr;
    }
  }

  .item-features h4, .item-impact h4 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-color);
    margin-bottom: 1rem;
  }

  .item-features ul, .item-impact ul {
    padding-left: 1.2rem;
    list-style: disc;
  }

  .item-features li, .item-impact li {
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .item-cloud {
    grid-column: 1 / -1;
    font-size: 0.9rem;
    color: var(--muted-color);
    padding: 0.75rem;
    background: var(--surface-flat);
    border-radius: 4px;
  }

  .collection-nav .nav-links {
    list-style: none;
    padding: 0;
  }

  .collection-nav .nav-links li {
    margin-bottom: 0.5rem;
  }

  .collection-nav .nav-links a {
    text-decoration: none;
    color: var(--text-color);
    font-size: 0.95rem;
    transition: color 0.15s ease;
  }

  .collection-nav .nav-links a:hover {
    color: var(--accent-color);
  }
</style>

<script>
  function copyCode(button) {
    const codeBlock = button.closest('.code-container').querySelector('code');
    const text = codeBlock.textContent;
    
    navigator.clipboard.writeText(text).then(() => {
      const originalText = button.textContent;
      button.textContent = 'Copied!';
      button.style.background = '#4CAF50';
      button.style.borderColor = '#4CAF50';
      
      setTimeout(() => {
        button.textContent = originalText;
        button.style.background = 'none';
        button.style.borderColor = '#555';
      }, 2000);
    });
  }
</script>